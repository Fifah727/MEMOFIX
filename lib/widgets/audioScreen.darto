import 'dart:io';
import 'package:flutter/material.dart';
import 'audioService.darto';

class AudioScreen extends StatefulWidget {
  const AudioScreen({super.key});

  @override
  State<AudioScreen> createState() => _AudioScreenState();
}

class _AudioScreenState extends State<AudioScreen> {
  List<AudioNote> notes = [];
  bool isRecording = false;
  String? tempPath;

  @override
  void initState() {
    super.initState();
    loadNotes();
  }

  Future<void> loadNotes() async {
    notes = await AudioService.getNotes();
    setState(() {});
  }

  Future<void> toggleRecording() async {
    if (isRecording) {
      await AudioService.stopRecording();
      if (tempPath != null) {
        final note = AudioNote(
          title: "Audio ${DateTime.now()}",
          path: tempPath!,
        );
        await AudioService.addNote(note);
      }
      tempPath = null;
      loadNotes();
    } else {
      tempPath = await AudioService.startRecording(
        "audio_${DateTime.now().millisecondsSinceEpoch}",
      );
    }
    setState(() => isRecording = !isRecording);
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Notes Audio"),
        backgroundColor: Colors.green.shade600,
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            ElevatedButton.icon(
              onPressed: toggleRecording,
              icon: Icon(isRecording ? Icons.stop : Icons.mic),
              label: Text(isRecording ? "Arrêter" : "Enregistrer"),
              style: ElevatedButton.styleFrom(
                backgroundColor: isRecording ? Colors.red : Colors.green,
                minimumSize: const Size(double.infinity, 50),
              ),
            ),
            const SizedBox(height: 16),
            Expanded(
              child: ListView.builder(
                itemCount: notes.length,
                itemBuilder: (context, index) {
                  final note = notes[index];
                  return ListTile(
                    leading: const Icon(Icons.audiotrack),
                    title: Text(note.title),
                    subtitle: Text(note.path),
                    trailing: IconButton(
                      icon: const Icon(Icons.delete),
                      onPressed: () async {
                        await AudioService.deleteNote(note.id!);
                        File(note.path).deleteSync();
                        loadNotes();
                      },
                    ),
                    onTap: () {
                      // Ici tu peux jouer l'audio avec FlutterSoundPlayer
                    },
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
