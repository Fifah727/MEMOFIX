  id_obj INTEGER PRIMARY KEY AUTOINCREMENT,
  periode TEXT,           -- jour, mois, annee
  valeur_cible TEXT,   -- % ou nombre d’étapes à atteindre
  id_bug INTEGER NULL,      -- optionnel : lié à un bug particulier
  FOREIGN KEY (id_bug) REFERENCES bug(id_bug) ON DELETE CASCADE
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
